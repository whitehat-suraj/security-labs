<group name="local,sshd,">
  <rule id="100100" level="10" frequency="5" timeframe="300">
    <if_matched_sid>5760</if_matched_sid>
    <same_source_ip />
    <description>Custom: 5+ failed SSH logins from one IP in 5 minutes</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>
</group>

"In this role it trigger alert when a attacker or a user login the ssh and failed 5 times in 5 min with same ip" 
